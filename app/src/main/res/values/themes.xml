<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Material 3, no action bar, edge-to-edge -->
    <style name="Theme.SineMiner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash theme (API 31+) -->
    <style name="Theme.SineMiner.Splash" parent="Theme.SineMiner">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
